{
  "name": "@moesi/oaath",
  "version": "0.12.0",
  "description": "Execute and recover reviewed Moesi plans through the public OAAth SDK.",
  "type": "module",
  "sideEffects": false,
  "license": "Apache-2.0",
  "author": "taek <leekt216@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/leekt/moesi.git",
    "directory": "packages/oaath-adapter"
  },
  "bugs": {
    "url": "https://github.com/leekt/moesi/issues"
  },
  "homepage": "https://github.com/leekt/moesi#readme",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=22.13"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome check . --diagnostic-level=error"
  },
  "dependencies": {
    "viem": "2.55.8"
  },
  "devDependencies": {
    "@types/node": "22.13.0",
    "tsdown": "0.22.7",
    "typescript": "7.0.2",
    "vitest": "4.1.0",
    "moesi": "workspace:*",
    "@oaath/sdk": "file:../../vendor/oaath/oaath-sdk-0.1.0.tgz"
  },
  "peerDependencies": {
    "moesi": "0.12.x || 0.13.x",
    "@oaath/sdk": "0.1.0"
  }
}
