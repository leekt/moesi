{
  "name": "@moesi/cli",
  "version": "0.15.1",
  "description": "Deployment-focused command line interface for Moesi.",
  "type": "module",
  "sideEffects": false,
  "license": "Apache-2.0",
  "author": "taek <leekt216@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/leekt/moesi.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/leekt/moesi/issues"
  },
  "homepage": "https://github.com/leekt/moesi#readme",
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "moesi": "./dist/bin.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "node ../../scripts/scrub-live-rpc-env.mjs vitest run",
    "lint": "biome check . --diagnostic-level=error",
    "release:check": "bun pm pack --dry-run --ignore-scripts",
    "release:publish": "bun publish --access public --tolerate-republish"
  },
  "dependencies": {
    "moesi": "workspace:*",
    "viem": "2.55.8"
  },
  "devDependencies": {
    "@types/node": "22.13.0",
    "tsdown": "0.22.7",
    "typescript": "7.0.2",
    "vitest": "4.1.0",
    "@moesi/oaath": "workspace:*"
  },
  "peerDependencies": {
    "@moesi/oaath": "workspace:>=0.15.0 <1.0.0"
  },
  "peerDependenciesMeta": {
    "@moesi/oaath": {
      "optional": true
    }
  }
}
