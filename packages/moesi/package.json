{
  "name": "moesi",
  "version": "0.12.0",
  "description": "Provider-neutral onchain Terraform: deterministic plans and verified convergence.",
  "type": "module",
  "sideEffects": false,
  "license": "Apache-2.0",
  "author": "taek <leekt216@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/leekt/moesi.git",
    "directory": "packages/moesi"
  },
  "bugs": {
    "url": "https://github.com/leekt/moesi/issues"
  },
  "homepage": "https://github.com/leekt/moesi#readme",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=22.13"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./viem": {
      "types": "./dist/viem/index.d.ts",
      "default": "./dist/viem/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude test/anvil-convergence.test.ts --exclude test/anvil-probes.test.ts",
    "test:anvil": "vitest run test/anvil-convergence.test.ts test/anvil-probes.test.ts",
    "lint": "biome check . --diagnostic-level=error"
  },
  "dependencies": {
    "viem": "2.55.8",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "22.13.0",
    "solc": "0.8.30",
    "tsdown": "0.22.7",
    "typescript": "7.0.2",
    "vitest": "4.1.0"
  }
}
