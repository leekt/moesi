{
  "name": "moesi",
  "version": "0.15.1",
  "description": "Provider-neutral onchain Terraform: deterministic plans and verified convergence.",
  "type": "module",
  "sideEffects": false,
  "license": "Apache-2.0",
  "author": "taek <leekt216@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/leekt/moesi.git",
    "directory": "packages/moesi"
  },
  "bugs": {
    "url": "https://github.com/leekt/moesi/issues"
  },
  "homepage": "https://github.com/leekt/moesi#readme",
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=22.13"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./viem": {
      "types": "./dist/viem/index.d.ts",
      "default": "./dist/viem/index.js"
    },
    "./fleet": {
      "types": "./dist/fleet/index.d.ts",
      "default": "./dist/fleet/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "bun": null,
      "node": "./dist/node/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "contracts",
    "THIRD_PARTY_NOTICES.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "node ../../scripts/scrub-live-rpc-env.mjs vitest run --exclude test/anvil-convergence.test.ts --exclude test/anvil-probes.test.ts",
    "test:anvil": "node ../../scripts/scrub-live-rpc-env.mjs vitest run test/anvil-convergence.test.ts test/anvil-probes.test.ts",
    "lint": "biome check . --diagnostic-level=error",
    "generate:proxy-artifacts": "node scripts/proxy-artifacts.mjs --write",
    "check:proxy-artifacts": "node scripts/proxy-artifacts.mjs",
    "release:check": "bun pm pack --dry-run --ignore-scripts",
    "release:publish": "bun publish --access public --tolerate-republish"
  },
  "dependencies": {
    "viem": "2.55.8",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@openzeppelin/contracts": "5.6.1",
    "@types/node": "22.13.0",
    "solc": "0.8.30",
    "tsdown": "0.22.7",
    "typescript": "7.0.2",
    "vitest": "4.1.0"
  }
}
